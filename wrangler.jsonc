{
  // Cloudflare Workers config — deploys the built SPA as static assets.
  // Redeploy with: npm run deploy (requires `wrangler login` or CLOUDFLARE_API_TOKEN)
  "name": "yigal",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
