{
  // Cloudflare Workers config — one worker serves the SPA (static assets) and the /api backend.
  // First-time setup: `npx wrangler d1 create tidelane`, paste the database_id below,
  // then `npm run db:migrate:remote` and `npm run deploy`.
  "name": "yigal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  // Runs before deploy/dev so CI (Workers Builds) and `wrangler deploy` always have a fresh dist/.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidelane",
      "database_id": "ea19d80a-6d78-4bf3-b050-d72614621db2",
      "migrations_dir": "migrations"
    }
  ]
}
